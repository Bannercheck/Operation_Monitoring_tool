# Watchover edge: TLS termination and reverse proxy in front of the dashboard container (./watchover.sh edge on <host>).
# Variables come from .env through docker-compose: WATCHOVER_EDGE_HOSTS (site addresses: "watchover.local, 192.168.1.107"),
# WATCHOVER_EDGE_HOST (the first of them, used when a client sends no server name),
# WATCHOVER_EDGE_TLS ("internal" = Caddy's own CA, export its root with  ./watchover.sh edge cert;
# or "/certs/watchover.crt /certs/watchover.key" for a company certificate placed in ./certs).
{
	admin off
	https_port {$WATCHOVER_EDGE_HTTPS_PORT:443}
	http_port {$WATCHOVER_EDGE_HTTP_PORT:80}
	# clients that connect by IP address send no SNI: serve the site's certificate anyway (curl / Safari 'tlsv1 alert internal error' otherwise)
	default_sni {$WATCHOVER_EDGE_HOST}
	fallback_sni {$WATCHOVER_EDGE_HOST}
	servers {
		protocols h1 h2       # no HTTP/3: only TCP 443 is published by compose, an advertised UDP 443 would make browsers stall
	}
}

{$WATCHOVER_EDGE_HOSTS} {
	tls {$WATCHOVER_EDGE_TLS:internal}
	encode gzip
	request_body {
		max_size 512MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# agents, enrolment, the agent installer and its verified bootstrap (/agent/boot.sh, /agent/ca.crt, /agent/manifest.json),
	# the binaries and the self-update check (/agent/wo-agent-*, /agent/update), the action agent's job channel (/agent/v1/*),
	# the web / mobile sensors and OTLP/HTTP (/v1/*) go to the Go receiver: agents use https://<NAME>/ingest like :8600
	@receiver path /ingest* /enroll* /agent.py /agent/* /rum /rum.js /mobile /v1/*
	handle @receiver {
		reverse_proxy receiver:8600
	}
	# our MCP server (./watchover.sh mcp on): https://<host>/mcp, Authorization: Bearer <key>; streamed answers are passed on at once.
	# (The API's own MCP endpoint stays at https://<host>/api/mcp, below.) While the MCP container is off this path answers 502.
	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy mcp:8765 {
			flush_interval -1
		}
	}
	# interface and API
	handle {
		reverse_proxy watchover:8501
	}
	log {
		output stdout
		format console
	}
}
