# PostgreSQL for Watchover (docker-compose.yml service "postgres"): the official postgres:16-alpine with its OS packages
# upgraded and gosu replaced. gosu (a Go binary built with Go 1.24.6) only drops root to the postgres user in the entrypoint,
# yet carried 26 Go standard library vulnerabilities (Trivy, October 2026). su-exec (C, Alpine package) does the same with the
# same arguments ("gosu postgres cmd ..."), so the official entrypoint runs unchanged. Same PostgreSQL binaries and data layout:
# an existing watchover-pg volume is used as it is.
ARG PG_TAG=16-alpine
FROM docker.io/library/postgres:${PG_TAG}
# gosu is deleted (the layer records the removal, so scanners no longer see the lower layer's binary) and su-exec answers to
# the name at another place on PATH: replacing the file in place would leave the old one visible in the image's lower layer
# WATCHOVER_OS_REFRESH (the build day, watchover.sh build_img): a new day re-runs the OS upgrade below instead of the cached layer
ARG WATCHOVER_OS_REFRESH=-
RUN : "os patches ${WATCHOVER_OS_REFRESH}" && apk upgrade --no-cache && apk add --no-cache su-exec \
    && rm -f /usr/local/bin/gosu && ln -s /sbin/su-exec /usr/bin/gosu \
    && [ "$(command -v gosu)" = /usr/bin/gosu ] && gosu nobody true && postgres --version
