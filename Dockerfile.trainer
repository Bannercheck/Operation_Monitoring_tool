# Watchover trainer — learns `watchover-ops` from the company's memory on CPU, unattended (llm profile).
# Same source tree as the dashboard plus the CPU builds of torch / transformers / peft. No GPU, no internet after the
# first run (the base weights are cached in the watchover-hf volume).
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    WATCHOVER_HOME=/data KNOWLEDGE_DB=/data/knowledge.db LIVE_SPOOL=/data/live/events.jsonl \
    HF_HOME=/hf TOKENIZERS_PARALLELISM=false
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 watchover && mkdir -p /app /data /hf /models && chown -R watchover:watchover /app /data /hf /models
WORKDIR /app
COPY pyproject.toml README.md CHANGELOG.md ./
COPY src ./src
COPY samples ./samples
RUN pip install --no-cache-dir --upgrade "pip>=26.2" "setuptools>=83" "wheel>=0.46.2" \
    && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu "torch>=2.2" \
    && pip install --no-cache-dir -e ".[postgres]" "transformers>=4.44" "peft>=0.12"
RUN chown -R watchover:watchover /app
USER watchover
VOLUME ["/data", "/hf", "/models"]
CMD ["python", "-m", "watchover.autotrain", "--loop"]
