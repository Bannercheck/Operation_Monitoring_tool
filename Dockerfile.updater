# Watchover updater (docker-compose.yml service "updater", ./watchover.sh updater on|off): in-app updates and rollbacks.
# The only Watchover container with the engine socket. This image carries tools only: Docker CLI with Compose, bash, GNU tar,
# Python 3 with cryptography (package signatures). The logic is NOT baked in: it runs src/watchover/updater.py and ./watchover.sh
# from the install folder (bind-mounted at the same path), so every release brings its own update logic and this image changes
# only with its tools (tag watchover-updater:1, UPDATER_TAG in watchover.sh). Podman installs build it with --build-arg PODMAN=1
# (the podman client, remote mode through CONTAINER_HOST).
FROM docker.io/library/docker:29.8.2-cli
ARG PODMAN=0
RUN apk add --no-cache bash coreutils findutils grep sed tar gzip curl openssl python3 py3-cryptography \
    && if [ "$PODMAN" = "1" ]; then apk add --no-cache podman; fi
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ENTRYPOINT []
CMD ["sh", "-c", "exec python3 \"$WATCHOVER_INSTALL_DIR/src/watchover/updater.py\" daemon"]
