# Watchover updater (docker-compose.yml service "updater", ./watchover.sh updater on|off): in-app updates and rollbacks.
# The only Watchover container with the engine socket. This image carries tools only: Docker CLI with Compose, bash, GNU tar,
# Python 3 with cryptography (package signatures). The logic is NOT baked in: it runs src/watchover/updater.py and ./watchover.sh
# from the install folder (bind-mounted at the same path), so every release brings its own update logic and this image changes
# only with its tools (tag watchover-updater:N, UPDATER_TAG in watchover.sh). Podman installs build it with --build-arg PODMAN=1
# (the podman client, remote mode through CONTAINER_HOST).
#
# Compose and buildx are rebuilt from their release sources with the current Go and patched modules: the binaries shipped in
# docker:*-cli carried golang.org/x/net and moby/go-archive versions with known vulnerabilities (Trivy, October 2026) while no
# newer release existed. The same Compose binary goes onto the RHEL host and into the offline bundle (install-rhel.sh, bundle).
ARG COMPOSE_VERSION=v5.6.1
ARG BUILDX_VERSION=v0.38.1

FROM docker.io/library/golang:1.26.10-alpine AS tools
ARG COMPOSE_VERSION
ARG BUILDX_VERSION
ENV GOFLAGS=-mod=mod CGO_ENABLED=0 GOTOOLCHAIN=local
RUN set -e; src() { d=$(go mod download -json "$1" | grep -o '"Dir": "[^"]*"' | cut -d'"' -f4); cp -r "$d" "$2"; chmod -R u+w "$2"; }; \
    src "github.com/docker/compose/v5@$COMPOSE_VERSION" /compose && cd /compose \
    && go get golang.org/x/net@v0.61.0 golang.org/x/crypto@v0.58.0 && go mod tidy \
    && go build -trimpath -ldflags "-s -w -X github.com/docker/compose/v5/internal.Version=$COMPOSE_VERSION" -o /out/docker-compose ./cmd \
    && src "github.com/docker/buildx@$BUILDX_VERSION" /buildx && cd /buildx \
    && go get github.com/moby/go-archive@v0.3.3 golang.org/x/net@v0.61.0 && go mod tidy \
    && go build -trimpath -ldflags "-s -w -X github.com/docker/buildx/version.Version=$BUILDX_VERSION" -o /out/docker-buildx ./cmd/buildx \
    && /out/docker-compose version --short && /out/docker-buildx version

FROM docker.io/library/docker:29.9.2-cli
ARG PODMAN=0
COPY --from=tools /out/docker-compose /out/docker-buildx /usr/local/libexec/docker/cli-plugins/
RUN apk upgrade --no-cache && apk add --no-cache bash coreutils findutils grep sed tar gzip curl openssl python3 py3-cryptography \
    && if [ "$PODMAN" = "1" ]; then apk add --no-cache podman; fi \
    && docker compose version --short && docker buildx version
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ENTRYPOINT []
CMD ["sh", "-c", "exec python3 \"$WATCHOVER_INSTALL_DIR/src/watchover/updater.py\" daemon"]
