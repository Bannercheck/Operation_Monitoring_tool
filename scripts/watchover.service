[Unit]
Description=Watchover operations signal desk
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=-__DIR__/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=__DIR__/.venv/bin/python -m streamlit run app.py --server.address 0.0.0.0 --server.port __PORT__ --server.headless true
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
