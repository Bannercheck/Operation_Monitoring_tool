# ./watchover.sh install copies this to .env and fills the secrets; edit .env, never this file.
# The image is built from this folder (no registry needed); ./watchover.sh sets WATCHOVER_TAG to the source version.
WATCHOVER_IMAGE=watchover
WATCHOVER_TAG=local
WATCHOVER_MCP=0                   # 1 = our MCP server runs as a third container (./watchover.sh mcp on)
WATCHOVER_LEGACY=0                # 1 = the former Streamlit interface as an extra container on :8502 (./watchover.sh legacy on)
WATCHOVER_LEGACY_PORT=8502
WATCHOVER_EDGE=0                  # 1 = Caddy in front: https://WATCHOVER_EDGE_HOST for the company network (./watchover.sh edge on <host>)
WATCHOVER_EDGE_HOST=              # first name colleagues type (used when a client sends no server name), e.g. watchover.local
WATCHOVER_EDGE_HOSTS=             # all names / IPs on the certificate, comma separated: watchover.local, 192.168.1.107
WATCHOVER_EDGE_TLS=internal       # internal = Caddy's own CA (export the root with ./watchover.sh edge cert) or: /certs/watchover.crt /certs/watchover.key
WATCHOVER_EDGE_HTTPS_PORT=443
WATCHOVER_EDGE_HTTP_PORT=80
# WATCHOVER_CORS=https://ops.sirket.com   # browser origins allowed to call the API (the future React UI)
WATCHOVER_UI_PORT=8501
WATCHOVER_LIVE_PORT=8600
WATCHOVER_MCP_PORT=8765
# MCP server (docker compose --profile mcp up -d): clients send  Authorization: Bearer <MCP_API_KEY>
#MCP_API_KEY=
# the MCP container forwards the live product's tools to the API's own MCP endpoint here (compose default: the dashboard service)
#WATCHOVER_API_URL=http://watchover:8501
# MCP_API_KEY is an installation-wide READ key (named, scoped keys: Ayarlar › Bağlantılar › MCP); remove the "# " below to let it write too
# MCP_API_KEY_WRITE=1
TZ=Europe/Istanbul
# container engine: docker or podman (rootful Podman on RHEL: podman.socket + Compose v2); empty = detected (a Docker CLI first)
WATCHOVER_ENGINE=
# raw logs on disks of their own (host directories, owner 10001:0, mode 2770; empty = inside the data volume):
#   hot = the last live_retention_h hours, fast disk (NVMe / SSD);  cold = the compressed archive, a cheaper disk
WATCHOVER_LOG_HOT_PATH=
WATCHOVER_LOG_COLD_PATH=
# backups: folder (another disk is better; empty = ./backups), how many to keep; nightly: ./watchover.sh backup-timer on [HH:MM]
WATCHOVER_BACKUP_DIR=
WATCHOVER_BACKUP_KEEP=14

# resources (docker compose honours these limits on a single host)
WATCHOVER_CPUS=4
WATCHOVER_MEMORY=4g
WATCHOVER_PG_CPUS=2
WATCHOVER_PG_MEMORY=2g

# --- Yerel LLM (Ollama, CPU) : ./watchover.sh llm on ile aç ---
# Boyutlandırma otomatiktir: watchover.sh her install/update/start'ta Docker'ın gördüğü CPU sayısını ve belleği ölçer,
# LLM ve eğitim servisine tüm CPU'ları (10'luk dizüstünde 10, 32'lik sunucuda 32) ve belleğin çoğunu tavan olarak yazar.
# Kendi değerlerini kullanmak istersen WATCHOVER_SIZING=manual yap ve aşağıdakileri elle doldur:
WATCHOVER_SIZING=auto
#WATCHOVER_LLM_CPUS=32
#WATCHOVER_LLM_MEMORY=48g
#WATCHOVER_LLM_THREADS=32
WATCHOVER_LLM_PARALLEL=1
WATCHOVER_LLM_MAX_MODELS=2
WATCHOVER_LLM_KEEPALIVE=30m
# İndirilecek modeller (sohbet/inceleme: qwen2.5 7B Q4, hızlı: 3B, gömme: bge-m3)
WATCHOVER_LLM_MODELS=qwen2.5:7b-instruct qwen2.5:3b-instruct bge-m3
LLM_MODEL=qwen2.5:7b-instruct
LLM_EMBED_MODEL=bge-m3
# Otomatik öğrenme (trainer servisi, llm profiliyle gelir): hafıza yeterince dolunca CPU'da LoRA eğitir, kalite kapısından geçerse watchover-ops olur
# (CPU/bellek sınırları da otomatik; manual modda: WATCHOVER_TRAIN_CPUS, WATCHOVER_TRAIN_MEMORY, WATCHOVER_TRAIN_THREADS)
# PostgreSQL reachable from the host for psql / pg_dump (localhost only)
WATCHOVER_PG_PORT=127.0.0.1:5433

# built-in monitoring of the container itself (1) — set 0 when the host runs its own agent
WATCHOVER_SELFMON=1
# demo mode (1): Operations › ⋯ › Simulator may feed synthetic hosts; 0 = production, the simulator cannot start and nothing demo is
# ever seeded. Existing demo data: ./watchover.sh demo-clean (or System › Demo data)
WATCHOVER_DEMO=1
# parallel parsing of multi-file uploads: empty = automatic (8+ cores), 1 = force on, 0 = off
WATCHOVER_PARALLEL=

# PostgreSQL (the product database; the compose file starts it next to the dashboard). Set a real password before the first start:
# it is baked into the database volume on creation.
POSTGRES_PASSWORD=change-me
POSTGRES_USER=watchover
POSTGRES_DB=watchover
# an existing PostgreSQL server instead of the bundled one: set the URL and start with  docker compose up -d --no-deps dashboard
#DATABASE_URL=postgresql://watchover:parola@db.example.com:5432/watchover
