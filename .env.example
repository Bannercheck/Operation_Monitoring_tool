# ÖRNEK İÇERİK - bu dosya commit EDİLİR, gerçek .env ASLA commit edilmez.
# Kullanım: cp .env.example .env  ve değerleri doldurun. Hiçbiri zorunlu değildir;
# uygulama varsayılanlarla çalışır (LLM / API anahtarı gerekmez).

# --- Uygulama ---
ACTIONS_DB=actions.db                 # aksiyon takibi SQLite dosyası
PLAYBOOK_DB=playbook.db               # hata kütüphanesi SQLite dosyası
KNOWLEDGE_DB=knowledge.db             # bilgi tabanı (dersler, kararlar, kurallar) SQLite dosyası
# DATABASE_URL=postgresql://user:pass@host:5432/watchover   # verilirse bilgi tabanı PostgreSQL'de tutulur (pip install psycopg[binary])

# --- Canlı alım (ajanlar) ---
LIVE_PORT=8600                        # POST /ingest alıcısının portu
LIVE_SPOOL=data/live/events.jsonl     # gelen canlı olayların diske yedeği
# Ajan tarafında: bu host'un ortam etiketi (prod / staging / test / dev)
AGENT_ENV=prod

# --- İsteğe bağlı yerel LLM (Connection Settings > LLM sekmesinden de girilebilir) ---
# OpenAI uyumlu uç: OpenLLM, Ollama, vLLM, LM Studio veya bulut
LLM_PROVIDER=auto                     # auto | openai | ollama | anthropic | gemini
LLM_BASE_URL=http://localhost:11434   # Ollama yerel API; OpenAI uyumlu için .../v1; Anthropic https://api.anthropic.com; Gemini https://generativelanguage.googleapis.com
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=example-key-xxxxxxxx
LLM_EMBED_MODEL=nomic-embed-text      # opsiyonel: bilgi tabanı aramasını anlamsal yapar
